meta {
  name: Nantes (realtime availability)
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/v1/parkings/nearby?lat=47.2138&lon=-1.5536&radius=2000&limit=10
  body: none
  auth: none
}

tests {
  test("status 200 and results present", function() {
    expect(res.status).to.eql(200);
    const results = res.getBody().results;
    expect(results.length).to.be.greaterThan(0);
  });

  test("realtime availability data present", function() {
    const results = res.getBody().results;
    // Nantes provides realtime availability
    const withAvailability = results.filter(p => p.availableSpots !== null);
    expect(withAvailability.length).to.be.greaterThan(0);

    // Nantes status semantics: grp_statut 5 → OPEN_OR_FULL (resolved from the spots
    // figure), 1/2 → CLOSED, unmapped/missing → UNKNOWN. A parking with free spots
    // can never report FULL.
    for (const p of withAvailability) {
      expect(["OPEN", "FULL", "CLOSED", "UNKNOWN"]).to.include(p.status);
      if (p.availableSpots > 0) {
        expect(p.status).to.not.eql("FULL");
      }
    }

    // At least one parking reports a live status (proves the status mapping flows).
    const live = results.filter(p => p.status === "OPEN" || p.status === "FULL");
    expect(live.length).to.be.greaterThan(0);
  });

  test("data is fresh (< 5 minutes old)", function() {
    const now = Date.now();
    for (const p of res.getBody().results) {
      const updated = new Date(p.sourceUpdatedAt).getTime();
      const ageMinutes = (now - updated) / 1000 / 60;
      expect(ageMinutes).to.be.lessThan(5);
    }
  });

  test("all results are from nantes", function() {
    for (const p of res.getBody().results) {
      expect(p.cityId).to.eql("nantes");
      expect(p.id).to.match(/^nantes:/);
    }
  });

  test("attribution contains nantes", function() {
    const attribution = res.getBody().attribution;
    expect(attribution.length).to.be.greaterThan(0);
    expect(attribution[0].cityId).to.eql("nantes");
  });

  test("results sorted by distance ascending", function() {
    const results = res.getBody().results;
    for (let i = 1; i < results.length; i++) {
      expect(results[i].distanceMeters).to.be.at.least(results[i - 1].distanceMeters);
    }
  });
}
