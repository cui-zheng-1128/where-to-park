meta {
  name: 400 lat out of range
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/v1/parkings/nearby?lat=999&lon=0
  body: none
  auth: none
}

tests {
  test("status 400", function() {
    expect(res.status).to.eql(400);
  });

  test("error message mentions lat", function() {
    const body = res.getBody();
    expect(body.message).to.exist;
    expect(body.message.toLowerCase()).to.include("lat");
  });
}
